# Vorlage für die Datei ".env" auf dem Online-Server.
# (Das Einrichtungs-Skript legt .env automatisch an – diese Datei ist nur zum Nachschauen.)

# Adresse, unter der die App erreichbar ist (muss auf die IP des Servers zeigen)
DOMAIN=unserhaushalt.duckdns.org

# Gemeinsames Passwort für alle im Haushalt (mind. 10 Zeichen).
# In einfache Anführungszeichen setzen, dann sind Sonderzeichen kein Problem.
HAUSHALT_PASSWORT='hier-ein-langes-passwort'
